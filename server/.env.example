# Puerto en el que escucha la API
PORT=5000

# Cadena de conexión a MongoDB local
# (el nombre de la base de datos se crea automáticamente al insertar datos)
MONGODB_URI=mongodb://127.0.0.1:27017/banco_simplificado

# Origen del frontend permitido por CORS (puedes poner varios separados por coma)
CLIENT_ORIGIN=http://localhost:5173

# development | production (en production no se exponen detalles internos de errores)
NODE_ENV=development
