# URL base de la API.
# Por defecto "/api" (usa el proxy de Vite hacia http://localhost:5000).
# Si despliegas la API en otro origen: VITE_API_URL=https://mi-servidor.com/api
VITE_API_URL=/api

# Moneda y formato regional para mostrar importes (códigos ISO 4217 / BCP 47)
VITE_MONEDA=PEN
VITE_LOCALE=es-PE
